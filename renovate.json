{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": [
    "after 6pm on friday"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.devcontainer/devcontainer\\.json$/",
        "/\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "go install github\\.com/oapi-codegen/oapi-codegen/v2/cmd/oapi-codegen@(?<currentValue>v[0-9.]+)"
      ],
      "depNameTemplate": "github.com/oapi-codegen/oapi-codegen",
      "datasourceTemplate": "go",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.devcontainer/devcontainer\\.json$/",
        "/\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "go install github\\.com/golangci/golangci-lint/cmd/golangci-lint@(?<currentValue>v[0-9.]+)"
      ],
      "depNameTemplate": "github.com/golangci/golangci-lint",
      "datasourceTemplate": "go",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "Group Go version updates across all files",
      "matchFileNames": [
        "api/go.mod",
        "api/Dockerfile",
        ".devcontainer/devcontainer.json",
        ".github/workflows/*.yml",
        ".github/workflows/*.yaml"
      ],
      "matchManagers": [
        "gomod",
        "dockerfile",
        "devcontainer",
        "custom.regex"
      ],
      "matchDepNames": [
        "golang",
        "go",
        "mcr.microsoft.com/devcontainers/go"
      ],
      "groupName": "Go version",
      "schedule": [
        "after 6pm on friday"
      ]
    },
    {
      "description": "Group oapi-codegen updates",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "github.com/oapi-codegen/oapi-codegen"
      ],
      "groupName": "oapi-codegen",
      "schedule": [
        "after 6pm on friday"
      ]
    },
    {
      "description": "Group golangci-lint updates",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "github.com/golangci/golangci-lint"
      ],
      "groupName": "golangci-lint",
      "schedule": [
        "after 6pm on friday"
      ]
    },
    {
      "description": "Group Go dependency patch and minor updates",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "Go dependencies (patch/minor)",
      "schedule": [
        "after 6pm on friday"
      ]
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "schedule": [
        "after 6pm on friday"
      ]
    },
    {
      "description": "Group DevContainer features updates",
      "matchManagers": [
        "devcontainer"
      ],
      "matchDepNames": [
        "ghcr.io/devcontainers/features/git",
        "ghcr.io/devcontainers/features/github-cli"
      ],
      "groupName": "DevContainer features",
      "schedule": [
        "after 6pm on friday"
      ]
    },
    {
      "description": "Docker distroless updates (individual PRs)",
      "matchManagers": [
        "docker"
      ],
      "matchDepNames": [
        "gcr.io/distroless/static-debian11"
      ],
      "schedule": [
        "after 6pm on friday"
      ]
    }
  ]
}
