# Authentication
AUTH_PROVIDER=stub

# Database Configuration (PostgreSQL)
STORAGE_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=rx
DB_PASSWORD=rx
DB_NAME=rx_workout
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# For production, use DATABASE_URL instead of individual DB_* variables
# DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require

# Object Storage (Optional)
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Server Configuration
PORT=8080
LOG_LEVEL=info
