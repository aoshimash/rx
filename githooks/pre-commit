#!/bin/sh
# Pre-commit hook: Run format, lint, and tests before commit
# This hook is enforced for all commits, including AI agent commits.
# DO NOT use --no-verify to skip this hook.

ROOT="$(git rev-parse --show-toplevel)"
STAGED_FILES=$(git diff --cached --name-only)

echo "Running pre-commit checks..."
echo ""

# Check if API files changed
if echo "$STAGED_FILES" | grep -q "^api/"; then
    echo "=== API checks ==="
    cd "$ROOT/api" || exit 1

    # Format check
    echo "1/3 Checking code format..."
    if ! task format; then
        echo "❌ Format check failed. Run 'go fmt ./...' to fix."
        exit 1
    fi

    # Lint check
    echo "2/3 Running linter..."
    if ! task lint; then
        echo "❌ Lint check failed. Fix linting errors before committing."
        exit 1
    fi

    # Test
    echo "3/3 Running tests..."
    if ! task test; then
        echo "❌ Tests failed. Fix failing tests before committing."
        exit 1
    fi

    echo "✅ API checks passed!"
    echo ""
fi

# Check if Web files changed
if echo "$STAGED_FILES" | grep -q "^web/"; then
    echo "=== Web checks ==="
    cd "$ROOT/web" || exit 1

    # Lint and format check
    echo "Running biome check..."
    if ! pnpm check; then
        echo "❌ Lint/format check failed. Run 'pnpm check:fix' to fix."
        exit 1
    fi

    echo "✅ Web checks passed!"
    echo ""
fi

echo "✅ All pre-commit checks passed!"
