#!/bin/sh
# Pre-commit hook: Run format, lint, and tests before commit
# This hook is enforced for all commits, including AI agent commits.
# DO NOT use --no-verify to skip this hook.

cd "$(git rev-parse --show-toplevel)/api" || exit 1

echo "Running pre-commit checks..."
echo ""

# Format check
echo "1/3 Checking code format..."
if ! task format; then
    echo "❌ Format check failed. Run 'go fmt ./...' to fix."
    exit 1
fi

# Lint check
echo "2/3 Running linter..."
if ! task lint; then
    echo "❌ Lint check failed. Fix linting errors before committing."
    exit 1
fi

# Test
echo "3/3 Running tests..."
if ! task test; then
    echo "❌ Tests failed. Fix failing tests before committing."
    exit 1
fi

echo ""
echo "✅ All pre-commit checks passed!"
